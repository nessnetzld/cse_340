<% if (title) { %>
<h1><%= title %></h1>
<% } %> <%- messages() %> <% if (typeof errors !== 'undefined' && errors &&
errors.array && errors.array().length) { %>
<ul class="notice">
  <% errors.array().forEach(error => { %>
  <li><%= error.msg %></li>
  <% }) %>
</ul>
<% } %>

<section class="account-management">
  <% if (typeof accountData !== 'undefined' && accountData) { %>
  <h2>Welcome <%= accountData.account_firstname %></h2>
  <% } %>

  <p>You're logged in</p>

  <div class="account-links">
    <a href="/account/update/<%= accountData.account_id %>" class="update-link"
      >Update Account Information</a
    >
  </div>

  <% if (accountData.account_type === "Employee" || accountData.account_type ===
  "Admin") { %>
  <h3>Inventory Management</h3>
  <p>
    <a href="/inv/">Access Inventory Management</a>
  </p>
  <% } %>
</section>
