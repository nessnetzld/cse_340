<% if (title) { %>
<h1><%= title %></h1>
<% } %> <%- messages() %> <% if (errors) { %>
<ul class="notice">
  <% errors.array().forEach(error => { %>
  <li><%= error.msg %></li>
  <% }) %>
</ul>
<% } %>

<section class="account-page">
  <p id="fields">*All fields are required.*</p>
  <form action="/account/register" method="post">
    <fieldset>
      <div class="form-row">
        <label for="account_firstname">First Name:</label>
        <input
          type="text"
          name="account_firstname"
          id="accountFirstname"
          required
          value="<%= locals.account_firstname %>"
        />
      </div>

      <div class="form-row">
        <label for="account_lastname">Last Name:</label>
        <input
          type="text"
          name="account_lastname"
          id="accountLastname"
          required
          value="<%= locals.account_lastname %>"
        />
      </div>

      <div class="form-row">
        <label for="account_email">Email:</label>
        <input
          type="email"
          name="account_email"
          id="accountEmail"
          required
          value="<%= locals.account_email %>"
          placeholder="user@example.com"
        />
      </div>

      <div class="form-row">
        <label for="account_password">Password:</label>
        <input
          id="account_password"
          name="account_password"
          type="password"
          placeholder="Password"
          required
          aria-describedby="pwd-instruction"
          pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
          title="Password must be minimum of 12 characters and
        include 1 capital letter, 1 number and 1 special character"
        />
        <div id="pwd-instruction" class="password-instruction">
          <i
            >Password must be minimum of 12 characters and include 1 capital
            letter, 1 number and 1 special character</i
          >
        </div>
      </div>

      <div class="form-row form-actions">
        <button id="showPwdBtn" type="button" class="show-password">
          Show password
        </button>
        <button type="submit" class="btn-primary">Register</button>
      </div>
    </fieldset>

    <div class="form-row small">
      <p>Already have an account? <a href="/account/login">Sign in</a></p>
    </div>
  </form>
</section>
