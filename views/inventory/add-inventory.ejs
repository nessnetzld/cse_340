<% if (title) { %>
<h1><%= title %></h1>
<% } %> <%- messages() %> <% if (typeof errors !== 'undefined' && errors &&
errors.array && errors.array().length) { %>
<ul class="notice">
  <% errors.array().forEach(err => { %>
  <li><%= err.msg %></li>
  <% }) %>
</ul>
<% } %>

<section id="add-inventory">
  <p class="required-field">*ALL FIELDS ARE REQUIRED*</p>

  <div class="form-container">
    <form action="/inv/add-inventory" method="post" novalidate>
      <div class="form-row">
        <label for="classificationList">Classification</label>
        <%- classificationList %>
      </div>

      <div class="form-row">
        <label for="inv_make">Make</label>
        <input
          id="inv_make"
          name="inv_make"
          type="text"
          required
          value="<%= inv_make || '' %>"
          placeholder="Min of 3 characters"
        />
      </div>

      <div class="form-row">
        <label for="inv_model">Model</label>
        <input
          id="inv_model"
          name="inv_model"
          type="text"
          required
          value="<%= inv_model || '' %>"
          placeholder="Min of 3 characters"
        />
      </div>

      <div class="form-row">
        <label for="inv_description">Description</label>
        <textarea
          id="inv_description"
          name="inv_description"
          rows="3"
          required
          placeholder="Product description visible to the customer"
        >
<%= inv_description || '' %></textarea
        >
      </div>

      <div class="form-row">
        <label for="inv_image">Image Path</label>
        <input
          id="inv_image"
          name="inv_image"
          type="text"
          required
          value="<%= inv_image || '/images/vehicles/no-image.png' %>"
        />
      </div>

      <div class="form-row">
        <label for="inv_thumbnail">Thumbnail Path</label>
        <input
          id="inv_thumbnail"
          name="inv_thumbnail"
          type="text"
          required
          value="<%= inv_thumbnail || '/images/vehicles/no-image.png' %>"
        />
      </div>

      <div class="form-row">
        <label for="inv_price">Price</label>
        <input
          id="inv_price"
          name="inv_price"
          type="number"
          step="0.01"
          min="0"
          required
          value="<%= inv_price || '' %>"
          placeholder="Decimal value (no commas or symbols)"
        />
      </div>

      <div class="form-row">
        <label for="inv_year">Year</label>
        <input
          id="inv_year"
          name="inv_year"
          type="number"
          min="1886"
          max="2100"
          required
          value="<%= inv_year || '' %>"
          placeholder="4-digit year"
        />
      </div>

      <div class="form-row">
        <label for="inv_miles">Miles</label>
        <input
          id="inv_miles"
          name="inv_miles"
          type="number"
          min="0"
          required
          value="<%= inv_miles || '' %>"
          placeholder="Whole number (no commas or decimals)"
        />
      </div>

      <div class="form-row">
        <label for="inv_color">Color</label>
        <input
          id="inv_color"
          name="inv_color"
          type="text"
          required
          value="<%= inv_color || '' %>"
          placeholder="The vehicle's color"
        />
      </div>

      <div class="form-row">
        <button type="submit" class="btn-primary">Add Vehicle</button>
      </div>
    </form>

    <div class="form-row back-link">
      <a href="/inv/" class="btn-link">Back</a>
    </div>
  </div>
</section>
