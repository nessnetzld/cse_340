<% if (title) { %>
<h1><%= title %></h1>
<% } %> <%- messages() %> <% if (typeof errors !== 'undefined' && errors &&
errors.array && errors.array().length) { %>
<ul class="notice">
  <% errors.array().forEach(error => { %>
  <li><%= error.msg %></li>
  <% }) %>
</ul>
<% } %>

<section id="add-classification">
  <p class="required-field">*FIELD IS REQUIRED*</p>

  <div class="form-container">
    <form action="/inv/add-classification" method="post" novalidate>
      <div class="form-row">
        <label for="classification_name">Classification Name</label>
        <p class="field-instruction">NAME MUST BE ALPHABETIC CHARACTERS ONLY</p>
        <input
          id="classification_name"
          name="classification_name"
          type="text"
          required
          maxlength="50"
          pattern="^[A-Za-z0-9]+$"
          title="No spaces or special characters. Use letters and numbers only."
          value="<%= (typeof classification_name !== 'undefined') ? classification_name : '' %>"
        />
      </div>

      <div class="form-row">
        <button type="submit" class="btn-primary">Add Classification</button>
      </div>
    </form>

    <div class="form-row back-link">
      <a href="/inv/" class="btn-link">Back</a>
    </div>
  </div>
</section>
