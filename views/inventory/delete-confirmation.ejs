<% if (title) { %>
<h1><%= title %></h1>
<% } %> <%- messages() %> <% if (typeof errors !== 'undefined' && errors &&
errors.array && errors.array().length) { %>
<ul class="notice">
  <% errors.array().forEach(err => { %>
  <li><%= err.msg %></li>
  <% }) %>
</ul>
<% } %>

<section id="delete-confirm">
  <p class="warning-message">Confirm Deletion - The delete is permanent.</p>

  <div class="form-container">
    <form action="/inv/delete" method="post">
      <div class="form-row">
        <label for="inv_make">Make</label>
        <input
          id="inv_make"
          name="inv_make"
          type="text"
          value="<%= inv_make %>"
          readonly
        />
      </div>

      <div class="form-row">
        <label for="inv_model">Model</label>
        <input
          id="inv_model"
          name="inv_model"
          type="text"
          value="<%= inv_model %>"
          readonly
        />
      </div>

      <div class="form-row">
        <label for="inv_year">Year</label>
        <input
          id="inv_year"
          name="inv_year"
          type="number"
          value="<%= inv_year %>"
          readonly
        />
      </div>

      <div class="form-row">
        <label for="inv_price">Price</label>
        <input
          id="inv_price"
          name="inv_price"
          type="number"
          step="0.01"
          value="<%= inv_price %>"
          readonly
        />
      </div>

      <div class="form-row">
        <button type="submit" class="btn-delete">Delete Vehicle</button>
      </div>

      <input
        type="hidden"
        name="inv_id"
        value="<%= locals.inv_id || inv_id %>"
      />
    </form>

    <div class="form-row back-link">
      <a href="/inv/" class="btn-link">Cancel - Back to Management</a>
    </div>
  </div>
</section>
